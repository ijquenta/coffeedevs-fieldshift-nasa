# Backend base URL. Used only when NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# true uses the deterministic mock services; false calls POST /predict and /analyze-product.
NEXT_PUBLIC_USE_MOCK=true

# Maximum field area accepted by the prediction form (hectares).
NEXT_PUBLIC_MAX_PREDICTION_AREA_HA=500

# Optional Cesium Ion access token. Leave unset to keep Cesium's default token.
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
