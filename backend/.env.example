# FieldShift Backend Configuration
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-3.8-flash es el más nuevo, pero puede responder 503 por alta demanda.
# gemini-3.1-flash-lite es estable para desarrollo y demos.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.3
PROJECT_NAME="FieldShift - Agronomic Copilot API"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
